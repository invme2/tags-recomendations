{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/invme2/tags-recomendations/blob/main/taxonomy/schema.json",
  "title": "Wanelo Taxonomy v3.x",
  "description": "Реальная схема (ADR-006). Сверена с taxonomy.json v3.2 (765 кластеров, 36 sections, 27 personas, 14 intents, 9 demos).",
  "type": "object",
  "required": ["version", "schema_version", "sections", "clusters", "personas", "intents", "demos"],
  "additionalProperties": true,
  "properties": {
    "version": {"type": "string"},
    "schema_version": {"type": "string"},
    "updated": {"type": "string"},
    "stats": {"type": "object", "additionalProperties": true},

    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/section"}
    },
    "clusters": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/cluster"}
    },
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/persona"}
    },
    "intents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/intent"}
    },
    "demos": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/demo"}
    }
  },

  "definitions": {
    "tagPattern": {
      "type": "string",
      "pattern": "^[a-z]+:[a-z0-9-]+$",
      "minLength": 3
    },

    "section": {
      "type": "object",
      "required": ["id", "slug", "title_en"],
      "additionalProperties": true,
      "properties": {
        "id":       {"type": "string", "minLength": 1},
        "slug":     {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "title_en": {"type": "string", "minLength": 1}
      }
    },

    "persona": {
      "type": "object",
      "required": ["tag", "title_en", "embed_text"],
      "additionalProperties": true,
      "properties": {
        "tag":        {"type": "string", "pattern": "^persona:[a-z0-9-]+$"},
        "title_en":   {"type": "string", "minLength": 1},
        "embed_text": {"type": "string", "minLength": 1}
      }
    },

    "intent": {
      "type": "object",
      "required": ["tag", "title_en", "embed_text", "rule"],
      "additionalProperties": true,
      "properties": {
        "tag":        {"type": "string", "pattern": "^intent:[a-z0-9-]+$"},
        "title_en":   {"type": "string", "minLength": 1},
        "embed_text": {"type": "string", "minLength": 1},
        "rule":       {"type": "string", "minLength": 1}
      }
    },

    "demo": {
      "type": "object",
      "required": ["tag", "title_en", "type"],
      "additionalProperties": true,
      "properties": {
        "tag":      {"type": "string", "pattern": "^demo:[a-z0-9-]+$"},
        "title_en": {"type": "string", "minLength": 1},
        "type":     {"type": "string", "enum": ["gender", "age"]}
      }
    },

    "clusterDemos": {
      "type": "object",
      "required": ["primary_gender", "ages"],
      "additionalProperties": true,
      "properties": {
        "primary_gender": {"type": "string"},
        "ages": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },

    "cluster": {
      "type": "object",
      "required": [
        "tag", "section_id", "section", "section_title_en",
        "title_en", "description", "embed_text",
        "typical_products", "personas", "intents", "demos",
        "related", "synonyms", "shopify_collection_hints",
        "status", "priority", "source"
      ],
      "additionalProperties": true,
      "properties": {
        "tag":               {"type": "string", "pattern": "^cluster:[a-z0-9-]+$"},
        "section_id":        {"type": "string", "minLength": 1},
        "section":           {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "section_title_en":  {"type": "string", "minLength": 1},
        "section_title_ru":  {"type": "string"},

        "title_en":          {"type": "string", "minLength": 1},
        "title_ru":          {"type": "string"},
        "description":       {"type": "string"},
        "embed_text":        {"type": "string", "minLength": 1},
        "typical_products":  {"type": "array", "items": {"type": "string"}},

        "personas": {
          "type": "array",
          "items": {"type": "string", "pattern": "^persona:[a-z0-9-]+$"}
        },
        "intents": {
          "type": "array",
          "items": {"type": "string", "pattern": "^intent:[a-z0-9-]+$"}
        },
        "demos": {"$ref": "#/definitions/clusterDemos"},
        "related": {
          "type": "array",
          "items": {"type": "string", "pattern": "^cluster:[a-z0-9-]+$"}
        },
        "synonyms":                 {"type": "array", "items": {"type": "string"}},
        "shopify_collection_hints": {"type": "array", "items": {"type": "string"}},

        "status":   {"type": "string", "enum": ["approved", "draft"]},
        "priority": {"type": "string", "enum": ["low", "medium", "high"]},
        "source":   {"type": "string"}
      }
    }
  }
}
