{%- comment -%}
  STATS snippet — 4-cell grid 2×2 with big numbers.
  Reads product.metafields.custom.stats JSON:
    {head: {kicker, h2, desc}, items: [{kicker, value, label}]}
  Designer should provide 4 items. value can contain <em>units</em>.
{%- endcomment -%}

{%- assign stats = product.metafields.custom.stats.value -%}
{%- if stats and stats.items and stats.items.size > 0 -%}
<section class="wanelo-section">
  {%- if stats.head and stats.head.h2 != blank -%}
    <div class="wanelo-head reveal">
      {%- if stats.head.kicker != blank -%}<div class="wanelo-kicker">{{ stats.head.kicker }}</div>{%- endif -%}
      <h2>{{ stats.head.h2 }}</h2>
      {%- if stats.head.desc != blank -%}<p class="desc">{{ stats.head.desc }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  <div class="wanelo-stats reveal">
    <div class="wanelo-stats__grid">
      {%- for item in stats.items limit: 4 -%}
        <div class="wanelo-stats__cell reveal delay-{{ forloop.index0 | plus: 1 }}">
          {%- if item.kicker != blank -%}<div class="wanelo-kicker">{{ item.kicker }}</div>{%- endif -%}
          {%- if item.value != blank -%}<div class="wanelo-stats__num">{{ item.value }}</div>{%- endif -%}
          {%- if item.label != blank -%}<div class="wanelo-stats__lbl">{{ item.label }}</div>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}
