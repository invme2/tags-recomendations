{%- comment -%}
  WHATS-INCLUDED snippet — items in box / bundle.
  Reads product.metafields.custom.whats_included JSON:
    {head: {kicker, h2, desc}, items: [{icon, name, qty, note}]}
  item.icon is one of the keys in wanelo-icons.liquid (typically check,
  gem, bolt, ribbon, etc). Old `glyph` field still accepted but ignored
  by default; pipeline can migrate glyph → icon mapping per category.
{%- endcomment -%}

{%- assign incl = product.metafields.custom.whats_included.value -%}
{%- if incl and incl.items and incl.items.size > 0 -%}
<section class="wanelo-section wanelo-whatsincluded reveal">
  {%- if incl.head and incl.head.h2 != blank -%}
    <div class="wanelo-head">
      {%- if incl.head.kicker != blank -%}<div class="wanelo-kicker">{{ incl.head.kicker }}</div>{%- endif -%}
      <h2>{{ incl.head.h2 }}</h2>
      {%- if incl.head.desc != blank -%}<p class="desc">{{ incl.head.desc }}</p>{%- endif -%}
    </div>
  {%- endif -%}
  <ul class="wanelo-whatsincluded__list">
    {%- for item in incl.items -%}
      {%- if item.name != blank -%}
        <li class="wanelo-whatsincluded__item">
          {%- if item.icon != blank -%}
            <span class="wanelo-whatsincluded__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><use href="#wanelo-icon-{{ item.icon }}"></use></svg>
            </span>
          {%- else -%}
            <span class="wanelo-whatsincluded__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><use href="#wanelo-icon-check"></use></svg>
            </span>
          {%- endif -%}
          <div class="wanelo-whatsincluded__body">
            <span class="wanelo-whatsincluded__name">{{ item.name }}</span>
            {%- if item.qty != blank -%}<span class="wanelo-whatsincluded__qty">×{{ item.qty }}</span>{%- endif -%}
            {%- if item.note != blank -%}<span class="wanelo-whatsincluded__note">{{ item.note }}</span>{%- endif -%}
          </div>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</section>
{%- endif -%}
