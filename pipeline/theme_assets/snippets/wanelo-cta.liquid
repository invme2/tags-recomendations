{%- comment -%}
  CTA snippet — centered call-to-action card.
  Reads product.metafields.custom.cta JSON:
    {kicker, h2, p, button_label}
  Button links to add-to-cart anchor (#product-form) by default.
{%- endcomment -%}

{%- assign cta = product.metafields.custom.cta.value -%}
{%- if cta and cta.h2 != blank -%}
<section class="wanelo-section">
  <div class="wanelo-cta reveal">
    {%- if cta.kicker != blank -%}<div class="wanelo-kicker">{{ cta.kicker }}</div>{%- endif -%}
    <h2>{{ cta.h2 }}</h2>
    {%- if cta.p != blank -%}<p>{{ cta.p }}</p>{%- endif -%}
    {%- if cta.button_label != blank -%}
      <a href="#product-form" class="wanelo-cta__button">{{ cta.button_label }}</a>
    {%- endif -%}
  </div>
</section>
{%- endif -%}
