{%- comment -%}
  HOW-TO snippet — numbered steps. Apple-style large numeral kicker
  (01 / 02 / 03), not a circular badge.
  Reads product.metafields.custom.how_to JSON:
    {head: {kicker, h2, desc}, items: [{n: 1, h4, p}]}
{%- endcomment -%}

{%- assign howto = product.metafields.custom.how_to.value -%}
{%- if howto and howto.items and howto.items.size > 0 -%}
<section class="wanelo-section wanelo-howto reveal">
  {%- if howto.head and howto.head.h2 != blank -%}
    <div class="wanelo-head">
      {%- if howto.head.kicker != blank -%}<div class="wanelo-kicker">{{ howto.head.kicker }}</div>{%- endif -%}
      <h2>{{ howto.head.h2 }}</h2>
      {%- if howto.head.desc != blank -%}<p class="desc">{{ howto.head.desc }}</p>{%- endif -%}
    </div>
  {%- endif -%}
  <ol class="wanelo-howto__list">
    {%- for step in howto.items -%}
      <li class="wanelo-howto__step">
        {%- assign step_n = step.n | default: forloop.index -%}
        <span class="wanelo-howto__n">{{ step_n | prepend: '0' | slice: -2, 2 }}</span>
        <div class="wanelo-howto__body">
          {%- if step.h4 != blank -%}<h4>{{ step.h4 }}</h4>{%- endif -%}
          {%- if step.p != blank -%}<p>{{ step.p }}</p>{%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ol>
</section>
{%- endif -%}
