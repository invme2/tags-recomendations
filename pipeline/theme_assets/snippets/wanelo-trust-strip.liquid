{%- comment -%}
  TRUST STRIP snippet — horizontal row of 4-6 trust icons + short labels.
  Reads product.metafields.custom.trust_strip JSON:
    {
      "items": [
        { "icon": "shipping" | "returns" | "leaf" | "lock" | "flag-us" | "shield" | "heart" | "leaf-eco" | "star" | "tag",
          "label": "Free shipping $50+" }
      ]
    }
  All icons are inline SVG — zero external deps, no Web fonts.
{%- endcomment -%}

{%- assign ts = product.metafields.custom.trust_strip.value -%}
{%- if ts and ts.items and ts.items.size > 0 -%}
<ul class="wanelo-trust-strip" aria-label="Trust badges">
  {%- for item in ts.items -%}
    {%- assign icon = item.icon | default: 'shield' -%}
    <li class="wanelo-trust-strip__item">
      <span class="wanelo-trust-strip__icon" aria-hidden="true">
        {%- case icon -%}
        {%- when 'shipping' -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        {%- when 'returns' -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/></svg>
        {%- when 'leaf' or 'leaf-eco' -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19.2 2.96a1 1 0 0 1 1.57.84C20.39 12 18.5 19 11 20z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/></svg>
        {%- when 'lock' -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        {%- when 'flag-us' -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22V4"/><path d="M4 5h12l-2 4 2 4H4"/></svg>
        {%- when 'heart' -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        {%- when 'star' -%}
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        {%- when 'tag' -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 13.42 20.58a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><circle cx="7" cy="7" r="1.5"/></svg>
        {%- else -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        {%- endcase -%}
      </span>
      <span class="wanelo-trust-strip__label">{{ item.label }}</span>
    </li>
  {%- endfor -%}
</ul>
{%- endif -%}
