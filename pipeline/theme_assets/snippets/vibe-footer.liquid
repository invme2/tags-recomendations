{%- comment -%} Wanelo Vibe shared footer. {%- endcomment -%}
<footer class="fftr">
  <div class="fftr__top">
    <div style="max-width:300px">
      <div class="flogo" style="margin-bottom:14px"><span class="mark"></span>wanelo <span class="yr">Vibe</span></div>
      <p style="color:var(--txt-2);font-size:14px;margin:0">The intelligent everything store. Describe it — we’ll deliver it.</p>
    </div>
    <div class="fftr__cols">
      <div class="fftr__col"><h4>Shop</h4><a href="{{ routes.collections_url }}">Categories</a><a href="{{ routes.collections_url }}">Live</a><a href="{{ routes.collections_url }}">Flash drops</a><a href="{{ routes.account_url }}">Wanelo Plus</a></div>
      <div class="fftr__col"><h4>Intelligence</h4><a href="{{ routes.search_url }}">AI concierge</a><a href="{{ routes.search_url }}">Visual search</a><a href="{{ routes.collections_url }}">Auto-reorder</a></div>
      <div class="fftr__col"><h4>Support</h4><a href="/pages/contact">Help</a><a href="/pages/contact">Delivery</a><a href="/pages/contact">Returns</a></div>
    </div>
  </div>
  <div class="fftr__bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span><span>Privacy · Terms · AI principles</span></div>
</footer>
{{ 'vibe.js' | asset_url | script_tag }}
