{%- comment -%}
  VARIANTS snippet — Apple-flat color chips (single row, swatch + name).
  Reads product.metafields.custom.variants JSON:
    {head: {kicker, h2, desc},
     items: [{name: "Sand", color: "#d4b896", available: true}]}
  Purely visual — Shopify product variants live elsewhere.
{%- endcomment -%}

{%- assign vr = product.metafields.custom.variants.value -%}
{%- if vr and vr.items and vr.items.size > 0 -%}
<section class="wanelo-section wanelo-variants reveal">
  {%- if vr.head and vr.head.h2 != blank -%}
    <div class="wanelo-head">
      {%- if vr.head.kicker != blank -%}<div class="wanelo-kicker">{{ vr.head.kicker }}</div>{%- endif -%}
      <h2>{{ vr.head.h2 }}</h2>
      {%- if vr.head.desc != blank -%}<p class="desc">{{ vr.head.desc }}</p>{%- endif -%}
    </div>
  {%- endif -%}
  <ul class="wanelo-variants__list">
    {%- for item in vr.items -%}
      {%- if item.name != blank -%}
        <li class="wanelo-variants__item{%- unless item.available %} wanelo-variants__item--soldout{% endunless -%}">
          <span class="wanelo-variants__swatch" style="background:{{ item.color | default: '#cccccc' }}"></span>
          <span class="wanelo-variants__name">{{ item.name }}</span>
          {%- unless item.available -%}<span class="wanelo-variants__soldout">Sold out</span>{%- endunless -%}
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</section>
{%- endif -%}
