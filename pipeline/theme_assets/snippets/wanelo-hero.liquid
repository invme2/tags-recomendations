{%- comment -%}
  HERO snippet — text + photo split.
  Reads product.metafields.custom.hero JSON:
    {kicker, h1, lead, image_url, image_alt}
  Inline CTA "Add to cart — $price" links to #wanelo-atc.
  data-wanelo-atc-link → wanelo.js attaches smooth-scroll + analytics.
{%- endcomment -%}

{%- assign hero = product.metafields.custom.hero.value -%}
{%- if hero and hero.h1 != blank -%}
<section class="wanelo-hero reveal">
  <div class="wanelo-hero__copy">
    {%- if hero.kicker != blank -%}
      <div class="wanelo-kicker reveal">{{ hero.kicker }}</div>
    {%- endif -%}
    <h1>
      <span class="mask"><span>{{ hero.h1 }}</span></span>
    </h1>
    {%- if hero.lead != blank -%}
      <p class="wanelo-hero__lead reveal delay-1">{{ hero.lead }}</p>
    {%- endif -%}

    <a href="#wanelo-atc" class="wanelo-hero__cta reveal delay-2"
       data-wanelo-atc-link>
      {{- shop.metafields.wanelo.cta_label | default: 'Add to cart' -}}
      {%- if product.price -%} — {{ product.price | money }}{%- endif -%}
      <span aria-hidden="true"> →</span>
    </a>
  </div>
  {%- if hero.image_url != blank -%}
    <div class="wanelo-hero__photo reveal">
      <img src="{{ hero.image_url }}"
           alt="{{ hero.image_alt | default: product.title | escape }}"
           loading="eager" fetchpriority="high" decoding="async">
    </div>
  {%- endif -%}
</section>
{%- endif -%}
