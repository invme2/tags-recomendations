{%- comment -%} Wanelo Vibe icon set (ported from the mockup icons.jsx). Usage: {% render 'vibe-icon', name:'cart', size:22, stroke:2, fill:'none' %} {%- endcomment -%}
{%- liquid
  assign sz = size | default: 24
  assign sw = stroke | default: 2
  assign fl = fill | default: 'none'
  case name
    when 'grid'
      assign d = '<rect x="3" y="3" width="7" height="7" rx="1.6"/><rect x="14" y="3" width="7" height="7" rx="1.6"/><rect x="3" y="14" width="7" height="7" rx="1.6"/><rect x="14" y="14" width="7" height="7" rx="1.6"/>'
    when 'search'
      assign d = '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/>'
    when 'camera'
      assign d = '<path d="M3 8.5A2.5 2.5 0 0 1 5.5 6h1.2L8 4h8l1.3 2h1.2A2.5 2.5 0 0 1 21 8.5v9A2.5 2.5 0 0 1 18.5 20h-13A2.5 2.5 0 0 1 3 17.5z"/><circle cx="12" cy="13" r="3.4"/>'
    when 'user'
      assign d = '<circle cx="12" cy="8" r="3.8"/><path d="M5 20c.6-3.6 3.4-5.5 7-5.5s6.4 1.9 7 5.5"/>'
    when 'heart'
      assign d = '<path d="M12 20s-7-4.5-9.3-9C1.2 8 2.6 4.8 6 4.8c2 0 3.2 1.2 4 2.4.8-1.2 2-2.4 4-2.4 3.4 0 4.8 3.2 3.3 6.2C19 15.5 12 20 12 20Z"/>'
    when 'cart'
      assign d = '<circle cx="9" cy="20" r="1.6"/><circle cx="18" cy="20" r="1.6"/><path d="M2.5 3.5H5l2.2 11.2a1.5 1.5 0 0 0 1.5 1.2h8.4a1.5 1.5 0 0 0 1.5-1.2L21 7H6"/>'
    when 'chevR'
      assign d = '<path d="m9 6 6 6-6 6"/>'
    when 'star'
      assign d = '<path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 17l-5.2 2.6 1-5.8-4.3-4.1 5.9-.9z"/>'
    when 'truck'
      assign d = '<path d="M3 6.5h11v9H3z"/><path d="M14 9.5h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>'
    when 'shield'
      assign d = '<path d="M12 3 5 6v5c0 4.2 2.9 7.6 7 9 4.1-1.4 7-4.8 7-9V6z"/><path d="m9 12 2 2 4-4"/>'
    when 'check'
      assign d = '<path d="m5 12 5 5 9-10"/>'
    when 'bolt'
      assign d = '<path d="M13 2 4 14h7l-2 8 9-12h-7z"/>'
    when 'tag'
      assign d = '<path d="M3 12V4h8l9 9-7 7-9-9z"/><circle cx="7.5" cy="7.5" r="1.4"/>'
    when 'arrowR'
      assign d = '<path d="M5 12h14M13 5l7 7-7 7"/>'
    when 'play'
      assign d = '<path d="M8 5v14l11-7z"/>'
    when 'spark'
      assign d = '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18"/>'
    when 'pct'
      assign d = '<circle cx="7.5" cy="7.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/><path d="M6 18 18 6"/>'
    when 'moon'
      assign d = '<path d="M20 14.5A8 8 0 0 1 9.5 4 7 7 0 1 0 20 14.5Z"/>'
    when 'eye'
      assign d = '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>'
    when 'coins'
      assign d = '<ellipse cx="9" cy="7" rx="6" ry="3"/><path d="M3 7v5c0 1.7 2.7 3 6 3s6-1.3 6-3V7"/><path d="M9 15v3c0 1.7 2.7 3 6 3s6-1.3 6-3v-5c0-1.4-1.9-2.6-4.5-2.9"/>'
    when 'rocket'
      assign d = '<path d="M5 15c-1.5 1.5-2 5-2 5s3.5-.5 5-2a3 3 0 0 0-3-3Z"/><path d="M8.5 14 5 12c0-5 4-9 9.5-9C20 3 21 4 21 9.5 21 15 17 19 12 19l-2-3.5"/><circle cx="14.5" cy="9.5" r="1.6"/>'
    when 'wallet'
      assign d = '<rect x="3" y="6" width="18" height="13" rx="2.5"/><path d="M3 10h18"/><circle cx="16.5" cy="14.5" r="1.3"/>'
    when 'cat_phone'
      assign d = '<rect x="7" y="3" width="10" height="18" rx="2.5"/><path d="M10.5 18h3"/>'
    when 'cat_home'
      assign d = '<path d="M4 11 12 4l8 7"/><path d="M6 10v9h12v-9"/>'
    when 'cat_shirt'
      assign d = '<path d="M8 4 4 7l2 3 2-1v9h8v-9l2 1 2-3-4-3-2 2-2 0z"/>'
    when 'cat_beauty'
      assign d = '<path d="M9 3h6l-1 5H10z"/><rect x="8" y="8" width="8" height="13" rx="2"/>'
    when 'cat_toy'
      assign d = '<circle cx="12" cy="9" r="5"/><path d="M12 14v7M8 18h8"/>'
    when 'cat_sport'
      assign d = '<circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="12" r="2.5"/><path d="M8.5 12h7M4 10v4M20 10v4"/>'
    when 'cat_auto'
      assign d = '<path d="M4 13l1.5-5h13L20 13"/><path d="M3 13h18v4H3z"/><circle cx="7.5" cy="17.5" r="1.4"/><circle cx="16.5" cy="17.5" r="1.4"/>'
    when 'cat_food'
      assign d = '<path d="M6 3v8a3 3 0 0 0 6 0V3M9 3v18"/><path d="M16 3c-1.5 1-2 3-2 5s.5 3 2 3v10"/>'
    when 'cat_pet'
      assign d = '<circle cx="7" cy="9" r="1.6"/><circle cx="12" cy="7" r="1.6"/><circle cx="17" cy="9" r="1.6"/><path d="M8 16c0-2.5 1.8-4 4-4s4 1.5 4 4-1.8 3-4 3-4-.5-4-3Z"/>'
    when 'cat_laptop'
      assign d = '<rect x="4" y="5" width="16" height="11" rx="1.5"/><path d="M2 19h20"/>'
    else
      assign d = ''
  endcase
-%}
<svg viewBox="0 0 24 24" width="{{ sz }}" height="{{ sz }}" fill="{{ fl }}" stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round"{% if class %} class="{{ class }}"{% endif %}{% if style %} style="{{ style }}"{% endif %}>{{ d }}</svg>
