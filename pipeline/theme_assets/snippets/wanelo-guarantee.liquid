{%- comment -%}
  GUARANTEE snippet — risk-reversal block. Always renders.

  Content is shop-level (configured ONCE in Shopify Admin → Settings →
  Custom data → Shop → wanelo.guarantee_*), NOT per-product. Falls back
  to sensible defaults if shop metafields aren't configured.

  Sits right after hero in product page render order — buyer sees risk
  reversal BEFORE scrolling deep, lifts cold-traffic CVR by 10-20%.

  Operator override:
    Shopify Admin → Settings → Custom data → Shop → Add definition:
      Namespace: wanelo
      Keys: return_policy, shipping, secure_checkout, return_days
    Each is a single_line_text_field. Edit once, applies store-wide.
{%- endcomment -%}

{%- assign g_return  = shop.metafields.wanelo.return_policy   | default: '30-day money-back' -%}
{%- assign g_return_p = shop.metafields.wanelo.return_note   | default: "Not what you expected? Send it back, full refund." -%}
{%- assign g_ship    = shop.metafields.wanelo.shipping        | default: 'Free shipping over $50' -%}
{%- assign g_ship_p  = shop.metafields.wanelo.shipping_note   | default: 'Fast delivery on US orders.' -%}
{%- assign g_secure  = shop.metafields.wanelo.secure_checkout | default: 'Secure checkout' -%}
{%- assign g_secure_p = shop.metafields.wanelo.secure_note   | default: 'SSL encrypted. Apple Pay, Stripe, PayPal accepted.' -%}

<section class="wanelo-guarantee reveal" aria-label="Why buy here">
  <div class="wanelo-g-grid">
    <div class="wanelo-g-item">
      <span class="wanelo-g-icon" aria-hidden="true">⟲</span>
      <div class="wanelo-g-text">
        <strong>{{ g_return }}</strong>
        <p>{{ g_return_p }}</p>
      </div>
    </div>
    <div class="wanelo-g-item">
      <span class="wanelo-g-icon" aria-hidden="true">⚡</span>
      <div class="wanelo-g-text">
        <strong>{{ g_ship }}</strong>
        <p>{{ g_ship_p }}</p>
      </div>
    </div>
    <div class="wanelo-g-item">
      <span class="wanelo-g-icon" aria-hidden="true">🔒</span>
      <div class="wanelo-g-text">
        <strong>{{ g_secure }}</strong>
        <p>{{ g_secure_p }}</p>
      </div>
    </div>
  </div>
</section>
