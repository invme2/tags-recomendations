{%- comment -%}
  INTERLINKS snippet — Apple-flat collection chips for SEO.
  Reads product.metafields.custom.interlinks JSON:
    {head: {kicker, h2}, items: [{handle, anchor}]}
  Pipeline pre-validates handles (only collections from current run).
{%- endcomment -%}

{%- assign interlinks = product.metafields.custom.interlinks.value -%}
{%- if interlinks and interlinks.items and interlinks.items.size > 0 -%}
<section class="wanelo-section wanelo-interlinks reveal">
  {%- if interlinks.head and interlinks.head.h2 != blank -%}
    <h3>{{ interlinks.head.h2 }}</h3>
  {%- else -%}
    <h3>Explore more</h3>
  {%- endif -%}
  <div class="wanelo-interlinks__list">
    {%- for item in interlinks.items -%}
      {%- if item.handle != blank -%}
        {%- assign li_coll = collections[item.handle] -%}
        {%- assign li_icon = li_coll.metafields.custom.icon | default: 'generic' -%}
        <a class="wanelo-interlinks__link" href="/collections/{{ item.handle }}">
          <span class="wanelo-interlinks__ico" aria-hidden="true">{%- render 'wanelo-icon', icon: li_icon -%}</span>
          <span class="wanelo-interlinks__txt">{{- item.anchor | default: item.handle -}}</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{%- endif -%}
