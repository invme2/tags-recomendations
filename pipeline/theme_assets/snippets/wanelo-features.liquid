{%- comment -%}
  FEATURES snippet — 3-card grid with numeric counters (01/02/03) OR
  inline SVG icons from wanelo-icons.liquid.
  Reads product.metafields.custom.features JSON:
    {head: {kicker, h2, desc}, items: [{icon, meta, h4, p}]}
  - item.icon (optional) → renders SVG <use href="#wanelo-icon-{icon}">.
  - If item.icon is blank, the auto-generated 01/02/03 numeral takes over.
  Designer should provide 3 items.
{%- endcomment -%}

{%- assign features = product.metafields.custom.features.value -%}
{%- if features and features.items and features.items.size > 0 -%}
<section class="wanelo-section">
  {%- if features.head and features.head.h2 != blank -%}
    <div class="wanelo-head reveal">
      {%- if features.head.kicker != blank -%}<div class="wanelo-kicker">{{ features.head.kicker }}</div>{%- endif -%}
      <h2>{{ features.head.h2 }}</h2>
      {%- if features.head.desc != blank -%}<p class="desc">{{ features.head.desc }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  <div class="wanelo-features__wrap reveal">
    <div class="wanelo-features__grid{% if features.items.first.image_url != blank %} wanelo-features__grid--photo{% endif %}">
      {%- for item in features.items limit: 3 -%}
        <div class="wanelo-features__card reveal delay-{{ forloop.index0 | plus: 1 }}">
          {%- comment -%} Oura-style: square photo on top of each feature card.
              Falls back to numeric counter when no image is provided. {%- endcomment -%}
          {%- if item.image_url != blank -%}
            <div class="wanelo-features__photo">
              <img src="{{ item.image_url }}" alt="{{ item.image_alt | default: item.h4 }}" loading="lazy">
            </div>
          {%- elsif item.icon != blank -%}
            <span class="wanelo-features__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><use href="#wanelo-icon-{{ item.icon }}"></use></svg>
            </span>
          {%- else -%}
            <div class="wanelo-features__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
          {%- endif -%}
          {%- if item.meta != blank -%}<div class="wanelo-features__meta">{{ item.meta }}</div>{%- endif -%}
          {%- if item.h4 != blank -%}<h4>{{ item.h4 }}</h4>{%- endif -%}
          {%- if item.p != blank -%}<p>{{ item.p }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}
