{%- comment -%}
  Wanelo Vibe — generic renderer for a designer metafield. Usage:
  {% render 'vibe-meta', key: 'compare', val: product.metafields.custom.compare.value %}
  Covers every designer metafield type (case by key) with a generic fallback.
{%- endcomment -%}
{%- assign h = val.head -%}
{%- capture head -%}<div class="vmf__head">{% if h.kicker %}<span class="vmf__kick">{{ h.kicker }}</span>{% endif %}<h2>{{ h.h2 }}</h2>{% if h.desc != blank %}<p>{{ h.desc }}</p>{% endif %}</div>{%- endcapture -%}
{%- case key -%}

{%- when 'hero' -%}
  {%- if val.h1 -%}<section class="fpsec"><div class="vmf-hero"><div>{% if val.kicker %}<span class="vmf__kick">{{ val.kicker }}</span>{% endif %}<h2>{{ val.h1 }}</h2>{% if val.lead %}<p>{{ val.lead }}</p>{% endif %}</div>{% if val.image_url %}<img class="vmf-hero__img" src="{{ val.image_url }}" alt="" loading="lazy">{% endif %}</div></section>{%- endif -%}

{%- when 'features' -%}
  {%- if val.items -%}<section class="fpsec vmf">{{ head }}<div class="vmf-feat">{%- for it in val.items -%}<div class="vmf-feat__card glass">{% if it.image_url %}<img class="vmf-feat__img" src="{{ it.image_url }}" alt="{{ it.image_alt | escape }}" loading="lazy">{% endif %}<div class="vmf-feat__body">{% if it.meta %}<span class="vmf__kick">{{ it.meta }}</span>{% endif %}<h4>{{ it.h4 }}</h4>{% if it.p %}<p>{{ it.p }}</p>{% endif %}</div></div>{%- endfor -%}</div></section>{%- endif -%}

{%- when 'stats' -%}
  {%- if val.items -%}<section class="fpsec vmf">{{ head }}<div class="vmf-stats">{%- for it in val.items -%}<div class="vmf-stat">{% if it.kicker %}<span class="kick">{{ it.kicker }}</span>{% endif %}<div class="big">{{ it.value }}</div><div class="lab">{{ it.label }}</div></div>{%- endfor -%}</div></section>{%- endif -%}

{%- when 'compare' -%}
  {%- if val.rows -%}<section class="fpsec vmf">{{ head }}<div class="vmf-cmp glass"><table><thead><tr><th></th>{%- for c in val.columns -%}<th>{{ c.name }}{% if c.badge != blank %}<span class="vmf-cmp__badge">{{ c.badge }}</span>{% endif %}</th>{%- endfor -%}</tr></thead><tbody>{%- for r in val.rows -%}<tr><td class="lbl">{{ r.label }}</td>{%- for v in r.values -%}<td>{{ v }}</td>{%- endfor -%}</tr>{%- endfor -%}</tbody></table></div></section>{%- endif -%}

{%- when 'timeline' -%}
  {%- if val.items -%}<section class="fpsec vmf">{{ head }}<div class="vmf-tl">{%- for it in val.items -%}<div class="vmf-tl__item"><span class="vmf-tl__when">{{ it.when }}</span><div class="vmf-tl__b"><h4>{{ it.h4 }}</h4>{% if it.p %}<p>{{ it.p }}</p>{% endif %}</div></div>{%- endfor -%}</div></section>{%- endif -%}

{%- when 'how_to' -%}
  {%- if val.items -%}<section class="fpsec vmf">{{ head }}<div class="vmf-steps">{%- for it in val.items -%}<div class="vmf-step"><span class="vmf-step__n">{{ it.n | default: forloop.index }}</span><div><h4>{{ it.h4 }}</h4><p>{{ it.p }}</p></div></div>{%- endfor -%}</div></section>{%- endif -%}

{%- when 'ingredients' -%}
  {%- if val.items -%}<section class="fpsec vmf">{{ head }}<div class="vmf-ingr">{%- for it in val.items -%}<div class="vmf-ingr__item glass"><div class="vmf-ingr__top"><b>{{ it.name }}</b>{% if it.badge != blank %}<span class="vmf-ingr__badge">{{ it.badge | remove: '[' | remove: ']' }}</span>{% endif %}</div><p>{{ it.role | default: it.desc | default: it.p }}</p></div>{%- endfor -%}</div></section>{%- endif -%}

{%- when 'care' -%}
  {%- if val.items -%}<section class="fpsec vmf">{{ head }}<div class="vmf-box">{%- for it in val.items -%}<div class="vmf-box__item"><span class="vmf-box__g">{{ it.glyph | default: '✦' }}</span><div><b>{{ it.label | default: it.name }}</b>{% if it.note %}<small>{{ it.note }}</small>{% endif %}</div></div>{%- endfor -%}</div></section>{%- endif -%}

{%- when 'whats_included' -%}
  {%- if val.items -%}<section class="fpsec vmf">{{ head }}<div class="vmf-box">{%- for it in val.items -%}<div class="vmf-box__item"><span class="vmf-box__g">{{ it.glyph | default: '✦' }}</span><div><b>{{ it.name }}{% if it.qty %} <span style="color:var(--txt-3);font-weight:600">×{{ it.qty }}</span>{% endif %}</b>{% if it.note %}<small>{{ it.note }}</small>{% endif %}</div></div>{%- endfor -%}</div></section>{%- endif -%}

{%- when 'dimensions' -%}
  {%- if val.items -%}<section class="fpsec vmf">{{ head }}<div class="vmf-dims">{%- for it in val.items -%}<div class="vmf-dim"><div class="v">{{ it.value }}</div><div class="a">{{ it.axis }}</div></div>{%- endfor -%}</div>{% if val.scale_note %}<div class="vmf-dims__note">{{ val.scale_note }}</div>{% endif %}</section>{%- endif -%}

{%- when 'story' -%}
  {%- if val.chapters -%}<section class="fpsec vmf">{{ head }}{%- for ch in val.chapters -%}<div class="vmf-story__ch">{% if ch.image_url %}<img class="vmf-story__img" src="{{ ch.image_url }}" alt="{{ ch.image_alt | escape }}" loading="lazy">{% endif %}<div class="vmf-story__t">{% if ch.kicker %}<span class="vmf__kick">{{ ch.kicker }}</span>{% endif %}<h3>{{ ch.h3 }}</h3>{% if ch.p %}<p>{{ ch.p }}</p>{% endif %}</div></div>{%- endfor -%}</section>{%- endif -%}

{%- when 'faq' -%}
  {%- if val.items -%}<section class="fpsec vmf" id="vibe-faq">{{ head }}<div class="vmf-faq">{%- for it in val.items -%}<div class="vmf-faq__item"><div class="vmf-faq__q">{{ it.q }}</div><div class="vmf-faq__a">{{ it.a }}</div></div>{%- endfor -%}</div></section>{%- endif -%}

{%- when 'interlinks' -%}
  {%- if val.items -%}<section class="fpsec vmf">{{ head }}<div class="vmf-links">{%- for it in val.items -%}<a href="/collections/{{ it.handle }}">{{ it.anchor | default: it.handle }} {% render 'vibe-icon', name:'arrowR', size:14, stroke:2.2 %}</a>{%- endfor -%}</div></section>{%- endif -%}

{%- when 'cta' -%}
  {%- if val.h2 or val.title -%}<a class="cbanner" href="#vibe-pform" style="margin-top:30px"><div class="cbanner__l"><span class="cbanner__tag">{% render 'vibe-icon', name:'spark', size:14 %} {{ val.kicker | default: 'Ready when you are' }}</span><h3>{{ val.h2 | default: val.title }}</h3>{% if val.lead or val.desc %}<p>{{ val.lead | default: val.desc }}</p>{% endif %}<span class="cbanner__cta">{{ val.button | default: 'Add to cart' }} {% render 'vibe-icon', name:'arrowR', size:17, stroke:2.4 %}</span></div><div class="cbanner__r"><span class="cbanner__orb">{% render 'vibe-icon', name:'cart', size:46, stroke:1.4 %}</span></div></a>{%- endif -%}

{%- when 'reviews' -%}
  {%- if val.items -%}
    {%- assign rtotal = 0 -%}
    {%- for it in val.items -%}{%- assign ssz = it.stars | remove: '☆' | remove: '✩' | size -%}{%- assign rtotal = rtotal | plus: ssz -%}{%- endfor -%}
    {%- assign ravg = rtotal | times: 1.0 | divided_by: val.items.size | round: 1 -%}
    {%- assign faqv = product.metafields.custom.faq.value -%}
    <section class="fpsec vmf" id="vibe-reviews">{{ head }}
      <div class="vmf-rate glass">
        <div class="vmf-rate__score"><div class="big">{{ ravg }}</div><div class="vmf-rate__stars">{% for i in (1..5) %}{% render 'vibe-icon', name:'star', size:16, fill:'#ffb020', stroke:0, style:'color:#ffb020' %}{% endfor %}</div><div class="vmf-rate__cnt">{{ val.items.size }} reviews</div></div>
        {%- if faqv.items -%}<a href="#vibe-faq" class="vmf-rate__q"><b>{{ faqv.items.size }}</b><span>questions</span></a>{%- endif -%}
      </div>
      <div class="vmf-rev">
        {%- for it in val.items -%}
          <div class="vmf-rev__card glass">
            <div class="vmf-rev__top"><span class="vmf-rev__av">{{ it.author | strip | slice: 0 | upcase }}</span><div class="vmf-rev__id"><div class="vmf-rev__name">{{ it.author }}</div><div class="vmf-rev__meta">{% render 'vibe-icon', name:'check', size:11, stroke:3 %} {{ it.meta | default: 'Verified buyer' }}</div></div><span class="vmf-rev__stars">{{ it.stars }}</span></div>
            <p>{{ it.quote }}</p>
          </div>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

{%- else -%}
  {%- comment -%} generic fallback for any other {head, items} metafield {%- endcomment -%}
  {%- if val.items and val.items.size > 0 -%}
    <section class="fpsec vmf">{{ head }}<div class="vmf-gen">
      {%- for it in val.items -%}
        {%- assign gh = it.h4 | default: it.label | default: it.name | default: it.title | default: it.q | default: it.when -%}
        {%- assign gb = it.p | default: it.note | default: it.role | default: it.a | default: it.desc | default: it.text | default: it.value -%}
        {%- if gh or gb -%}<div class="vmf-gen__item glass">{% if it.glyph %}<span class="vmf-box__g">{{ it.glyph }}</span>{% endif %}<div>{% if gh %}<b>{{ gh }}</b>{% endif %}{% if gb %}<p>{{ gb }}</p>{% endif %}</div></div>{%- endif -%}
      {%- endfor -%}
    </div></section>
  {%- endif -%}
{%- endcase -%}
