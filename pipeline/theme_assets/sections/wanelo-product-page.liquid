{%- comment -%}
  WANELO Product Page — single section, renders the entire long-form
  description from up to 34 Shopify metafield modules. Skip-if-blank
  gates inside every snippet — empty metafield = section hidden.

  Round-4 (Apple aesthetic): system fonts, dark var-swap, monochrome +
  accent, pill CTAs inheriting --btn-primary-*.
  Round-5 (category expansion #1): +6 modules — target-profile, video-
  demo, protocol, compatibility, assembly, safety.
  Round-6 (category expansion #2): +8 modules — brand-story, lifestyle-
  gallery, nutrition-facts, clinical-evidence, app-showcase, room-
  placement, subscription-refill, sustainability.

  Render order is FIXED. Pipeline tests assert this sequence.
{%- endcomment -%}

{{ 'wanelo.css' | asset_url | stylesheet_tag }}
<style>
  .wanelo-vrow { max-width:1080px; margin:clamp(40px,5.5vw,80px) auto; display:grid; gap:clamp(20px,4vw,56px); align-items:center; grid-template-columns:minmax(0,1fr) minmax(0,1fr); }
  .wanelo-vrow--solo { max-width:360px; grid-template-columns:1fr; }
  .wanelo-vrow__media { width:100%; max-width:340px; margin:0 auto; }
  .wanelo-vrow--video-right .wanelo-vrow__media { order:2; }
  .wanelo-vrow--video-right .wanelo-vrow__content { order:1; }
  .wanelo-vslot__frame { position:relative; aspect-ratio:9/16; border-radius:20px; overflow:hidden; background:#000; box-shadow:0 14px 40px rgba(0,0,0,.16); }
  .wanelo-vslot__frame video, .wanelo-vslot__frame iframe { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; border:0; display:block; }
  .wanelo-vslot__video { cursor:pointer; }
  .wanelo-vslot__sound { position:absolute; bottom:14px; right:14px; z-index:2; width:42px; height:42px; border-radius:50%; border:1px solid rgba(255,255,255,.25); background:rgba(0,0,0,.42); color:#fff; cursor:pointer; padding:0; display:flex; align-items:center; justify-content:center; -webkit-backdrop-filter:blur(6px); backdrop-filter:blur(6px); box-shadow:0 2px 10px rgba(0,0,0,.25); transition:background .2s, transform .15s; }
  .wanelo-vslot__sound:hover { background:rgba(0,0,0,.62); transform:scale(1.07); }
  .wanelo-vslot__sound:active { transform:scale(.95); }
  .wanelo-vslot__ic { width:20px; height:20px; display:block; }
  .wanelo-vslot__ic--on { display:none; }
  .wanelo-vslot__sound.is-on .wanelo-vslot__ic--mute { display:none; }
  .wanelo-vslot__sound.is-on .wanelo-vslot__ic--on { display:block; }
  .wanelo-vrow__content { max-width:430px; }
  .wanelo-vrow__icon { display:inline-flex; width:44px; height:44px; border-radius:13px; background:#f3f4f6; align-items:center; justify-content:center; color:#111; margin-bottom:14px; }
  .wanelo-vrow__icon svg { width:23px; height:23px; }
  .wanelo-vrow__eyebrow { font-size:12px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:#9ca3af; margin-bottom:10px; }
  .wanelo-vrow__heading { font-size:clamp(20px,2.4vw,29px); font-weight:700; letter-spacing:-0.02em; color:#1a1a1a; margin:0 0 11px; line-height:1.2; }
  .wanelo-vrow__body { font-size:clamp(14px,1.5vw,16px); color:#4b5563; line-height:1.6; margin:0; }
  .wanelo-vslot__eyebrow-solo { text-align:center; font-size:12px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:#9ca3af; margin-top:12px; }
  @media (max-width:749px){ .wanelo-vrow{ grid-template-columns:1fr; gap:18px; max-width:380px; } .wanelo-vrow--video-right .wanelo-vrow__media,.wanelo-vrow--video-right .wanelo-vrow__content{ order:0; } .wanelo-vrow__content{ max-width:none; text-align:center; } .wanelo-vrow__icon{ margin-left:auto; margin-right:auto; } }
</style>
