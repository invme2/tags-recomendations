    <span class="wanelo-page__toggle-less" hidden>Show less</span>
    <span class="wanelo-page__toggle-chev" aria-hidden="true">&#x25BE;</span>
  </button>

  <script src="{{ 'wanelo.js' | asset_url }}" defer></script>
  <script>
  (function(){
    var slots = document.querySelectorAll('.wanelo-vslot__frame[data-vslot]');
    if(!slots.length) return;
    // Autoplay (muted) when scrolled into view, pause when out — TikTok/Reels style.
    if('IntersectionObserver' in window){
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          var v = e.target.querySelector('video');
          if(!v) return;
          if(e.isIntersecting && e.intersectionRatio >= 0.5){ v.play().catch(function(){}); }
          else { v.pause(); }
        });
      }, {threshold:[0,0.5,1]});
      slots.forEach(function(s){ io.observe(s); });
    } else {
      slots.forEach(function(s){ var v=s.querySelector('video'); if(v) v.play().catch(function(){}); });
    }
    // Tap video = play/pause. Sound button = mute/unmute.
    slots.forEach(function(s){
      var v = s.querySelector('video');
      var btn = s.querySelector('[data-vsound]');
      if(v){ v.addEventListener('click', function(){ if(v.paused){ v.play().catch(function(){}); } else { v.pause(); } }); }
      if(v && btn){
        btn.addEventListener('click', function(ev){
          ev.preventDefault(); ev.stopPropagation();
          v.muted = !v.muted;
          btn.classList.toggle('is-on', !v.muted);
          if(!v.muted){ v.play().catch(function(){}); }
        });
      }
    });
  })();
  </script>
