{%- comment -%}
  WANELO Best Sellers — homepage section showing products tagged 'has-video'.
  Each card plays its first marketing video (from custom.videos metafield)
  instead of the hero image. Fallback: featured image if no video.

  PERFORMANCE:
  - Videos are NOT loaded until the card enters the viewport (IntersectionObserver).
  - Poster = thumbnail_url (tiny JPEG loaded immediately, like a normal image).
  - muted + loop + playsinline — iOS autoplay requires muted.
  - No preload="auto" — only preload="none" until in view.
  - Images use loading="lazy" for cards without video.
  - All JS is inline, minimal, no external deps.
{%- endcomment -%}

{%- assign coll = collections['top-best-sellers'] -%}
{%- if coll == blank or coll.products_count == 0 -%}{% comment %}nothing to show{% endcomment %}{%- else -%}

<section class="wbs" aria-label="{{ section.settings.heading | escape }}">
  <div class="wbs__head">
    {%- if section.settings.eyebrow != blank -%}
      <div class="wbs__eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    <h2 class="wbs__h2">{{ section.settings.heading | default: 'Best Sellers' }}</h2>
    {%- if section.settings.sub != blank -%}
      <p class="wbs__sub">{{ section.settings.sub }}</p>
    {%- endif -%}
  </div>

  <div class="wbs__track" data-wbs-track>
    {%- for product in coll.products limit: section.settings.limit -%}
      {%- assign vf = product.metafields.custom.videos.value -%}
      {%- assign first_item = nil -%}
      {%- if vf and vf.items and vf.items.size > 0 -%}
        {%- assign first_item = vf.items[0] -%}
      {%- endif -%}
      {%- assign has_video = false -%}
      {%- assign vurl = '' -%}
      {%- assign vthumb = '' -%}
      {%- if first_item != nil -%}
        {%- assign vurl = first_item.url | default: '' -%}
        {%- assign vthumb = first_item.thumbnail_url | default: '' -%}
        {%- if vurl contains '.mp4' or vurl contains '.webm' or first_item.platform == 'higgsfield-mp4' -%}
          {%- assign has_video = true -%}
        {%- endif -%}
      {%- endif -%}

      <a class="wbs__card" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
        <div class="wbs__media">
          {%- if has_video -%}
            {%- comment -%}
              poster shows instantly (like a normal product photo).
              <source> is injected by JS only when card enters viewport.
              data-src holds the actual .mp4 URL — no network call until needed.
            {%- endcomment -%}
            <video class="wbs__vid"
                   muted loop playsinline
                   preload="none"
                   poster="{{ vthumb }}"
                   data-src="{{ vurl }}#t=0.1"
                   aria-hidden="true"></video>
            <noscript>
              {%- if vthumb != blank -%}
                <img src="{{ vthumb }}" alt="{{ product.title | escape }}" loading="lazy">
              {%- elsif product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
              {%- endif -%}
            </noscript>
            <button type="button" class="wbs__sound" data-wbs-sound aria-label="Toggle sound">
              <svg class="wbs__ic wbs__ic--off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z"/><line x1="22" y1="9" x2="16" y2="15"/><line x1="16" y1="9" x2="22" y2="15"/></svg>
              <svg class="wbs__ic wbs__ic--on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M18.5 5.5a9 9 0 0 1 0 13"/></svg>
            </button>
          {%- elsif product.featured_image -%}
            <img src="{{ product.featured_image | image_url: width: 600 }}"
                 alt="{{ product.title | escape }}" loading="lazy" width="600" height="600">
          {%- endif -%}
          {%- unless section.settings.hide_badge -%}
            <span class="wbs__badge">▶ Video</span>
          {%- endunless -%}
        </div>
        <div class="wbs__info">
          <span class="wbs__title">{{ product.title }}</span>
          <span class="wbs__price">{{ product.price | money }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>

  {%- if section.settings.cta_label != blank -%}
    <div class="wbs__cta-wrap">
      <a href="{{ coll.url }}" class="wbs__cta btn btn--primary">{{ section.settings.cta_label }}</a>
    </div>
  {%- endif -%}
</section>

<style>
  .wbs { max-width: 1400px; margin: 0 auto; padding: clamp(40px,5vw,72px) clamp(16px,4vw,40px); }
  .wbs__head { text-align: center; margin-bottom: clamp(24px,3vw,40px); }
  .wbs__eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #9ca3af; margin-bottom: 10px; }
  .wbs__h2 { font-size: clamp(26px,3vw,40px); font-weight: 700; letter-spacing: -0.02em; color: #1a1a1a; margin: 0 0 0.4rem; }
  .wbs__sub { font-size: clamp(14px,1.4vw,16px); color: #6b7280; margin: 0; }
  /* horizontal scroll on mobile, grid on desktop */
  .wbs__track { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: clamp(12px,1.5vw,20px); }
  @media (max-width: 640px) { .wbs__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px; padding-bottom: 8px; -webkit-overflow-scrolling: touch; scrollbar-width: none; } .wbs__track::-webkit-scrollbar { display: none; } }
  .wbs__card { display: block; text-decoration: none; color: inherit; scroll-snap-align: start; min-width: 200px; transition: transform .22s; }
  .wbs__card:hover { transform: translateY(-3px); }
  .wbs__media { position: relative; aspect-ratio: 9/16; border-radius: 16px; overflow: hidden; background: #f4f4f5; }
  .wbs__media img, .wbs__media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .wbs__badge { position: absolute; top: 10px; left: 10px; background: rgba(0,0,0,.52); color: #fff; font-size: 11px; font-weight: 600; letter-spacing: .04em; padding: 3px 8px; border-radius: 99px; backdrop-filter: blur(4px); }
  .wbs__sound { position: absolute; bottom: 10px; right: 10px; z-index: 2; width: 36px; height: 36px; border-radius: 50%; border: 1px solid rgba(255,255,255,.25); background: rgba(0,0,0,.42); color: #fff; cursor: pointer; padding: 0; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(6px); transition: background .2s; }
  .wbs__sound:hover { background: rgba(0,0,0,.65); }
  .wbs__ic { width: 17px; height: 17px; display: block; }
  .wbs__ic--on { display: none; }
  .wbs__sound.is-on .wbs__ic--off { display: none; }
  .wbs__sound.is-on .wbs__ic--on { display: block; }
  .wbs__info { padding: .65rem .1rem 0; }
  .wbs__title { display: block; font-size: 14px; font-weight: 600; color: #1a1a1a; line-height: 1.3; margin-bottom: 3px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .wbs__price { font-size: 14px; color: #6b7280; font-weight: 500; }
  .wbs__cta-wrap { text-align: center; margin-top: clamp(24px,3vw,40px); }
  .wbs__cta { display: inline-block; padding: 12px 32px; border-radius: 999px; font-weight: 600; font-size: 15px; text-decoration: none; background: #1a1a1a; color: #fff; transition: background .2s; }
  .wbs__cta:hover { background: #333; }
</style>

<script>
(function() {
  var track = document.querySelector('[data-wbs-track]');
  if (!track) return;
  var videos = track.querySelectorAll('.wbs__vid[data-src]');
  if (!videos.length) return;

  // Lazy-load + autoplay: inject <source> only when card enters viewport.
  // This avoids loading ANY video bytes until the user actually sees the card.
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        var v = e.target;
        if (e.isIntersecting) {
          if (!v.querySelector('source')) {
            var s = document.createElement('source');
            s.src = v.dataset.src;
            s.type = 'video/mp4';
            v.appendChild(s);
            v.load();
          }
          v.play().catch(function(){});
        } else {
          v.pause();
        }
      });
    }, { threshold: 0.4 });
    videos.forEach(function(v) { io.observe(v); });
  } else {
    // Fallback: load all immediately for older browsers.
    videos.forEach(function(v) {
      var s = document.createElement('source');
      s.src = v.dataset.src; s.type = 'video/mp4';
      v.appendChild(s); v.load(); v.play().catch(function(){});
    });
  }

  // Sound toggle.
  track.querySelectorAll('[data-wbs-sound]').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault(); e.stopPropagation();
      var v = btn.closest('.wbs__media').querySelector('video');
      if (!v) return;
      v.muted = !v.muted;
      btn.classList.toggle('is-on', !v.muted);
      if (!v.muted) v.play().catch(function(){});
    });
  });
})();
</script>

{%- endif -%}

{% schema %}
{
  "name": "Wanelo Best Sellers",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FEATURED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best Sellers" },
    { "type": "text", "id": "sub", "label": "Subheading", "default": "Our most-loved products, seen in action" },
    { "type": "range", "id": "limit", "label": "Max products", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "text", "id": "cta_label", "label": "CTA button label", "default": "Shop all" },
    { "type": "checkbox", "id": "hide_badge", "label": "Hide Video badge", "default": false }
  ],
  "presets": [{ "name": "Wanelo Best Sellers" }]
}
{% endschema %}
