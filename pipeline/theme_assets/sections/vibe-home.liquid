{%- comment -%}
  Wanelo Vibe — bespoke homepage matching the Wanelo Vibe mockup.
  Reuses the mockup CSS (assets/vibe.css) and emits the same DOM, wired to
  Shopify data (cart, search, collections, products). Operator guardrails honoured.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Onest:wght@400;500;600;700;800&display=swap" rel="stylesheet">
{{ 'vibe.css' | asset_url | stylesheet_tag }}

<style>
  /* page chrome: hide the theme header/footer on the Vibe homepage, set page bg */
  body.template-index .shopify-section-group-header-group,
  body.template-index .shopify-section-group-footer-group { display: none !important; }
  body.template-index { background: var(--vibe-bg, #f5f3ff); }
  .vibe-home .fpcard__img img { width: 100%; height: 100%; object-fit: cover; }
  .vibe-home .aipick__img img { width: 100%; height: 100%; object-fit: cover; }
  .vibe-home { --vibe-bg: #f5f3ff; }
</style>

{%- liquid
  assign feat_col = section.settings.featured_collection
  assign feat = feat_col.products.first
-%}

<div class="vibe-home">
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><filter id="lgDistort" x="-20%" y="-20%" width="140%" height="140%"><feTurbulence type="fractalNoise" baseFrequency="0.009 0.014" numOctaves="2" seed="7" result="n"/><feGaussianBlur in="n" stdDeviation="1.1" result="sn"/><feDisplacementMap in="SourceGraphic" in2="sn" scale="16" xChannelSelector="R" yChannelSelector="G"/></filter></svg>

  <div class="fwrap">
    {% render 'vibe-header' %}

    <!-- ===== AI hero ===== -->
    <div class="ai-hero">
      <div class="fhero-l">
        <span class="fhero-eyebrow"><span class="tag-aurora">{{ section.settings.eyebrow_tag | default: 'Wanelo Intelligence' }}</span> · {{ section.settings.eyebrow_rest | default: '14M products, one prompt' }}</span>
        <h1 class="fhero-h1">{{ section.settings.title_1 | default: 'Shopping that' }}<br><span class="neon-text">{{ section.settings.title_2 | default: 'thinks with you.' }}</span></h1>
        <p class="fhero-sub">{{ section.settings.subtitle | default: 'Describe what you need in plain language. Wanelo finds it, compares it, and delivers it — same day.' }}</p>
        <form class="aibar" action="{{ routes.search_url }}" method="get">
          <span class="ai-orb"></span>
          <input name="q" placeholder="Try &ldquo;a birthday gift for my dad who loves cycling&rdquo;">
          <button class="aibar__send" type="submit">{% render 'vibe-icon', name:'arrowR', size:20, stroke:2.4 %}</button>
        </form>
        <div class="ai-sugs">
          {%- assign sugs = section.settings.suggestions | default: 'Gift under $50 for a coffee lover|Set up a home gym|Best phone for photography|Refresh my bathroom' | split: '|' -%}
          {%- for s in sugs -%}
            <a class="fchip" href="{{ routes.search_url }}?q={{ s | url_encode }}">{{ s }}</a>
          {%- endfor -%}
        </div>
      </div>

      <div class="fhero-r">
        <div class="fhero-r__top">
          <div class="gcard glass col tint-cyan">
            <div class="gcard__label"><span class="live-dot"></span>Trending now</div>
            {%- assign trend_col = collections['bestsellers'] -%}
            {%- if trend_col == blank or trend_col.products.size == 0 -%}{%- assign trend_col = feat_col -%}{%- endif -%}
            {%- if trend_col == blank or trend_col.products.size == 0 -%}{%- assign trend_col = collections.all -%}{%- endif -%}
            <div class="gtrend">
              {%- assign tn = 0 -%}
              {%- for product in trend_col.products limit: 12 -%}
                {%- if product.available and tn < 5 -%}
                  {%- assign tn = tn | plus: 1 -%}
                  <a href="{{ product.url }}" class="gtrend__item">
                    <span class="gtrend__rank">{{ tn }}</span>
                    {%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 120 }}" width="42" height="42" alt="{{ product.title | escape }}">{%- else -%}<span class="gtrend__ph"></span>{%- endif -%}
                    <span class="gtrend__info"><span class="gtrend__t">{{ product.title | truncate: 34 }}</span><span class="gtrend__p">{{ product.price | money }}</span></span>
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <div class="gtrend__live"><span class="live-dot"></span><b data-viewers>2 481</b> shoppers browsing live</div>
          </div>
          <div class="gcard glass col tint-mag">
            <div class="gcard__label">{% render 'vibe-icon', name:'bolt', size:13, style:'color:var(--neon-mag)' %}Flash drop ends</div>
            {%- assign flashn = 0 -%}
            <div class="fdrop">
              {%- for product in trend_col.products offset: 5 limit: 40 -%}
                {%- if product.compare_at_price > product.price and flashn < 4 -%}
                  {%- assign flashn = flashn | plus: 1 -%}
                  {%- assign fdisc = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
                  <a href="{{ product.url }}" class="fdrop__item">
                    {%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 120 }}" width="42" height="42" alt="{{ product.title | escape }}">{%- else -%}<span class="fdrop__ph"></span>{%- endif -%}
                    <span class="fdrop__info"><span class="fdrop__t">{{ product.title | truncate: 30 }}</span><span class="fdrop__prices"><b class="fdrop__p">{{ product.price | money }}</b><s class="fdrop__old">{{ product.compare_at_price | money }}</s></span></span>
                    <span class="fdrop__disc">-{{ fdisc }}%</span>
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <div class="countdown" data-countdown>
              <div class="cd-unit"><b data-h>05</b><span>hrs</span></div>
              <div class="cd-unit"><b data-m>20</b><span>min</span></div>
              <div class="cd-unit"><b data-s>00</b><span>sec</span></div>
            </div>
          </div>
        </div>
        <div class="gcard glass aipick tint-violet">
          <div class="gcard__label">{% render 'vibe-icon', name:'spark', size:13, style:'color:var(--neon-violet)' %}AI pick for you</div>
          {%- if feat -%}
          <a class="aipick__img" href="{{ feat.url }}">
            {%- if feat.featured_image -%}<img src="{{ feat.featured_image | image_url: width: 500 }}" alt="{{ feat.title | escape }}" loading="lazy">{%- else -%}<span class="fph"><span class="fph__mesh tint-cyan"></span></span>{%- endif -%}
          </a>
          <div class="aipick__name">{{ feat.title | truncate: 46 }}</div>
          <div class="aipick__row">
            <span class="aipick__price neon-text">{{ feat.price | money }}</span>
            {%- if feat.available -%}<a class="fbtn fbtn-glass fbtn-sm" href="{{ feat.url }}">{% render 'vibe-icon', name:'cart', size:16 %} Add</a>{%- endif -%}
          </div>
          {%- else -%}
          <div class="aipick__img"><span class="fph"><span class="fph__mesh tint-cyan"></span></span></div>
          <div class="aipick__name">Pick a featured collection in the editor</div>
          {%- endif -%}
        </div>
      </div>
    </div>

    <!-- ===== feature strip ===== -->
    <div class="fstats">
      <div class="fstat glass"><span class="fstat__ic">{% render 'vibe-icon', name:'truck', size:20 %}</span><div><b>Same-day</b><span>autonomous delivery</span></div></div>
      <div class="fstat glass"><span class="fstat__ic">{% render 'vibe-icon', name:'spark', size:20 %}</span><div><b>AI concierge</b><span>shops for you 24/7</span></div></div>
      <div class="fstat glass"><span class="fstat__ic">{% render 'vibe-icon', name:'shield', size:20 %}</span><div><b>Zero-risk</b><span>90-day instant returns</span></div></div>
      <div class="fstat glass"><span class="fstat__ic">{% render 'vibe-icon', name:'wallet', size:20 %}</span><div><b>Pay in 4</b><span>0% with Wanelo Pay</span></div></div>
    </div>

    <!-- ===== browse the universe (orbs) ===== -->
    <section class="fsec">
      <div class="fsec__head"><div><h2>Browse the universe</h2><p>Every category, one tap away</p></div></div>
      <div class="orbs">
        {%- assign orbcols = section.settings.orb_collections | default: '' | split: ',' -%}
        {%- assign orb_defs = 'Electronics:cat_phone,Home & Garden:cat_home,Clothing & Shoes:cat_shirt,Beauty & Health:cat_beauty,Kids & Toys:cat_toy,Sport & Outdoor:cat_sport,Auto:cat_auto,Grocery:cat_food,Pet Supplies:cat_pet' | split: ',' -%}
        {%- for od in orb_defs -%}
          {%- assign parts = od | split: ':' -%}
          <a href="{{ routes.collections_url }}" class="orb"><span class="orb__c">{% render 'vibe-icon', name: parts[1], size:30, stroke:1.6 %}</span><span>{{ parts[0] }}</span></a>
        {%- endfor -%}
        <a href="{{ routes.collections_url }}" class="orb"><span class="orb__c" style="color:var(--neon-mag)">{% render 'vibe-icon', name:'pct', size:30, stroke:1.6 %}</span><span>Clearance</span></a>
      </div>
    </section>

    <!-- ===== product carousels (blocks) ===== -->
    {%- for block in section.blocks -%}
      {%- if block.type == 'row' -%}
        {%- assign col = block.settings.collection -%}
        <section class="fsec" {{ block.shopify_attributes }}>
          <div class="fsec__head">
            <div><h2>{{ block.settings.title | default: col.title }}</h2>{% if block.settings.subtitle != blank %}<p>{{ block.settings.subtitle }}</p>{% endif %}</div>
            <a href="{{ col.url | default: routes.collections_url }}">Explore all {% render 'vibe-icon', name:'arrowR', size:15, stroke:2.2 %}</a>
          </div>
          <div class="fgrid" style="--fc:5">
            {%- for product in col.products limit: 5 -%}
              {% render 'vibe-card', product: product %}
            {%- else -%}
              <p style="color:var(--txt-3)">Assign a collection to this row in the editor.</p>
            {%- endfor -%}
          </div>
        </section>

        {%- if forloop.first -%}
          <!-- ===== Wanelo Clips (static showcase) ===== -->
          <section class="fsec">
            <div class="fsec__head">
              <div><h2 style="white-space:nowrap"><span class="live-dot" style="display:inline-block;vertical-align:middle;margin-right:10px"></span>Wanelo Clips</h2><p>Watch, then shop the look — every video is instantly buyable</p></div>
              <a href="{{ routes.collections_url }}">Open feed {% render 'vibe-icon', name:'arrowR', size:15, stroke:2.2 %}</a>
            </div>
            <div class="clips-rail" data-clips-rail>
              <a class="clipcard more" href="{{ routes.collections_url }}"><span class="inner"><span class="c">{% render 'vibe-icon', name:'arrowR', size:24, stroke:2.2 %}</span>Open full feed</span></a>
            </div>
            <script src="{{ 'vibe-clips.js' | asset_url }}" defer></script>
          </section>

          <!-- ===== creator banner ===== -->
          <a class="cbanner" href="{{ routes.collections_url }}">
            <div class="cbanner__l">
              <span class="cbanner__tag">{% render 'vibe-icon', name:'spark', size:14 %} Wanelo for Creators</span>
              <h3>Turn your clips into income</h3>
              <p>Earn three ways — <b>$2 per 1,000 views</b>, up to <b>50% of every sale</b>, plus paid brand features.</p>
              <span class="cbanner__cta">Start earning {% render 'vibe-icon', name:'arrowR', size:17, stroke:2.4 %}</span>
            </div>
            <div class="cbanner__r">
              <span class="cbanner__chip a">{% render 'vibe-icon', name:'eye', size:15 %} +2,300 views</span>
              <span class="cbanner__chip b">{% render 'vibe-icon', name:'coins', size:15 %} +$24</span>
              <span class="cbanner__chip c">{% render 'vibe-icon', name:'tag', size:15 %} 3 sales</span>
              <span class="cbanner__orb">{% render 'vibe-icon', name:'rocket', size:46, stroke:1.4 %}</span>
            </div>
          </a>

          <!-- ===== promos ===== -->
          <div class="fpromos">
            <div class="fpromo tint-blue">
              <div class="fpromo__art">{% render 'vibe-icon', name:'cat_laptop', size:180, stroke:1 %}</div>
              <h3>Tech, upgraded</h3><p>Next-gen phones, laptops &amp; wearables with AI built in.</p>
              <a href="{{ routes.collections_url }}" class="fbtn fbtn-primary">Shop electronics</a>
            </div>
            <div class="fpromo tint-mag"><h3>Beauty lab</h3><p>Personalised skincare from $1.99.</p><a href="{{ routes.collections_url }}" class="fbtn fbtn-glass">Discover</a></div>
            <div class="fpromo tint-violet"><h3>Home OS</h3><p>Smart living, beautifully designed.</p><a href="{{ routes.collections_url }}" class="fbtn fbtn-glass">Browse home</a></div>
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

  </div>
</div>

<script>
(function(){
  var root = document.currentScript.closest('body') || document.body;
  // countdown to local midnight
  var cd = document.querySelector('[data-countdown]');
  if (cd){ var h=cd.querySelector('[data-h]'),m=cd.querySelector('[data-m]'),s=cd.querySelector('[data-s]');
    function tick(){ var n=new Date(),e=new Date(n); e.setHours(24,0,0,0); var t=Math.max(0,Math.floor((e-n)/1000));
      var p=function(x){return String(x).padStart(2,'0')}; h.textContent=p(Math.floor(t/3600)); m.textContent=p(Math.floor(t%3600/60)); s.textContent=p(t%60); }
    tick(); setInterval(tick,1000); }
  // viewers ticker
  var vw=document.querySelector('[data-viewers]');
  if(vw){ var v=2481; setInterval(function(){ v+=Math.round((Math.random()-0.45)*12); vw.textContent=v.toLocaleString('ru-RU').replace(/,/g,' '); },2200); }
  // favourite toggle (visual only)
  document.querySelectorAll('[data-fav]').forEach(function(b){ b.addEventListener('click',function(e){ e.preventDefault(); b.classList.toggle('on'); var sv=b.querySelector('svg'); if(sv) sv.setAttribute('fill', b.classList.contains('on')?'var(--neon-mag)':'none'); }); });
  // night toggle
  var nt=document.querySelector('[data-night-toggle]'); var vh=document.querySelector('.vibe-home');
  if(nt&&vh){ try{ if(localStorage.getItem('vibe_night')==='1') vh.classList.add('night'); }catch(e){} nt.addEventListener('click',function(){ vh.classList.toggle('night'); try{ localStorage.setItem('vibe_night', vh.classList.contains('night')?'1':'0'); }catch(e){} }); }
  // add to cart (AJAX)
  document.querySelectorAll('[data-add]').forEach(function(b){ b.addEventListener('click',function(){ var id=b.getAttribute('data-add'); if(!id) return;
    b.classList.add('added'); var old=b.innerHTML; b.textContent='✓ In cart';
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:[{id:id,quantity:1}]})})
      .then(function(r){return r.json()}).then(function(){ var c=document.querySelector('.fhdr .ficon .cnt'); if(c){c.textContent=(parseInt(c.textContent||'0')+1);} setTimeout(function(){ b.classList.remove('added'); b.innerHTML=old; },1500); })
      .catch(function(){ b.classList.remove('added'); b.innerHTML=old; }); }); });
})();
</script>

<script>
document.addEventListener('DOMContentLoaded', function(){
  var rail = document.querySelector('[data-clips-rail]');
  var clips = (window.VIBE_CLIPS || []).slice();
  if(!rail || !clips.length) return;
  for(var i=clips.length-1;i>0;i--){ var j=Math.floor(Math.random()*(i+1)); var t=clips[i]; clips[i]=clips[j]; clips[j]=t; }
  var pick = clips.slice(0, 10);
  var moreCard = rail.querySelector('.clipcard.more');
  var vk = function(n){ return n>=1000 ? (n/1000).toFixed(1).replace('.0','')+'K' : ''+n; };
  var esc = function(s){ return (s||'').replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); };
  pick.forEach(function(c, i){
    var a = document.createElement('a'); a.className='clipcard'; a.href=c.url;
    var views = vk(2000 + Math.floor(Math.random()*40000));
    a.innerHTML =
      '<video class="clipcard__vid" src="'+esc(c.v)+'" '+(c.poster?('poster="'+esc(c.poster)+'" '):'')+'muted loop playsinline preload="none"></video>'+
      '<div class="clipcard__scrim"></div>'+
      '<div class="clipcard__top"><span class="clipcard__views">&#9654; '+views+'</span>'+(i===0?'<span class="clipcard__live">Live</span>':'')+'</div>'+
      '<span class="clipcard__shop">&#128722; Shop</span>'+
      '<div class="clipcard__bottom"><div class="clipcard__title">'+esc(c.title)+'</div></div>';
    rail.insertBefore(a, moreCard);
  });
  var vids = rail.querySelectorAll('.clipcard__vid');
  if('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(es){ es.forEach(function(e){ var v=e.target; if(e.isIntersecting){ var p=v.play&&v.play(); if(p&&p.catch)p.catch(function(){}); } else if(v.pause){ v.pause(); } }); }, {threshold:0.4});
    vids.forEach(function(v){ io.observe(v); });
  } else {
    vids.forEach(function(v){ var p=v.play&&v.play(); if(p&&p.catch)p.catch(function(){}); });
  }
});
</script>

{% schema %}
{
  "name": "Vibe Home",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow_tag", "label": "Eyebrow tag", "default": "Wanelo Intelligence" },
    { "type": "text", "id": "eyebrow_rest", "label": "Eyebrow rest", "default": "14M products, one prompt" },
    { "type": "text", "id": "title_1", "label": "Title line 1", "default": "Shopping that" },
    { "type": "text", "id": "title_2", "label": "Title line 2 (accent)", "default": "thinks with you." },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Describe what you need in plain language. Wanelo finds it, compares it, and delivers it — same day." },
    { "type": "text", "id": "suggestions", "label": "Suggestion chips (| separated)", "default": "Gift under $50 for a coffee lover|Set up a home gym|Best phone for photography|Refresh my bathroom" },
    { "type": "collection", "id": "featured_collection", "label": "AI-pick / featured collection" }
  ],
  "blocks": [
    { "type": "row", "name": "Product row", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "subtitle", "label": "Subtitle" }
    ]}
  ],
  "presets": [
    { "name": "Vibe Home", "blocks": [
      { "type": "row", "settings": { "title": "Curated for you", "subtitle": "Learned from everything you’ve loved" } },
      { "type": "row", "settings": { "title": "Flash drops", "subtitle": "Live deals — gone when the timer hits zero" } },
      { "type": "row", "settings": { "title": "Trending in your city", "subtitle": "Popular right now" } }
    ]}
  ]
}
{% endschema %}
