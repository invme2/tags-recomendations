{%- comment -%}
  Wanelo Vibe — product page matching the mockup (Wanelo Vibe Product.html).
  Real Shopify data. Fabricated reviews / AI claims from the mockup are intentionally
  omitted (FTC + operator guardrail). Reuses vibe.css + shared header/footer.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Onest:wght@400;500;600;700;800&display=swap" rel="stylesheet">
{{ 'vibe.css' | asset_url | stylesheet_tag }}
<style>
  .shopify-section-group-header-group, .shopify-section-group-footer-group { display: none !important; }
  body { background: #f5f3ff; }
  .vibe-home .fpcard__img img, .vibe-home .fgmain img, .vibe-home .fgthumb img { width: 100%; height: 100%; object-fit: cover; }
  .vibe-home .fgmain img { object-fit: contain; }
</style>

{%- assign cv = product.selected_or_first_available_variant -%}
<div class="vibe-home">
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><filter id="lgDistort" x="-20%" y="-20%" width="140%" height="140%"><feTurbulence type="fractalNoise" baseFrequency="0.009 0.014" numOctaves="2" seed="7" result="n"/><feGaussianBlur in="n" stdDeviation="1.1" result="sn"/><feDisplacementMap in="SourceGraphic" in2="sn" scale="16" xChannelSelector="R" yChannelSelector="G"/></filter></svg>
  <div class="fwrap">
    {% render 'vibe-header', active: '' %}

    <div class="fcrumbs" style="margin-top:22px;display:flex;align-items:center;gap:8px;color:var(--txt-3);font-size:13px">
      <a href="{{ routes.root_url }}">Home</a>{% render 'vibe-icon', name:'chevR', size:13 %}
      {%- if product.collections.first -%}<a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>{% render 'vibe-icon', name:'chevR', size:13 %}{%- endif -%}
      <span style="color:var(--txt-2)">{{ product.title | truncate: 40 }}</span>
    </div>

    <div class="fpdp">
      <!-- gallery -->
      <div class="fgallery">
        <div class="fgthumbs">
          {%- for image in product.images limit: 7 -%}
            <button type="button" class="fgthumb glass{% if forloop.first %} on{% endif %}" data-fgthumb="{{ forloop.index0 }}" style="background-image:url('{{ image | image_url: width: 160 }}');background-size:cover;background-position:center"></button>
          {%- endfor -%}
        </div>
        <div class="fgmain glass">
          <div class="fgnav">
            <button type="button" class="fgnav__btn" data-fgback aria-label="Back">{% render 'vibe-icon', name:'chevL', size:22, stroke:2.4 %}</button>
            <div class="fgnav__r">
              <button type="button" class="fgnav__btn" data-fav aria-label="Save">{% render 'vibe-icon', name:'heart', size:20 %}</button>
              <button type="button" class="fgnav__btn" data-fgshare aria-label="Share">{% render 'vibe-icon', name:'share', size:18 %}</button>
            </div>
          </div>
          {%- if product.images.size > 1 -%}<span class="fgcount"><b data-fgcount>1</b>/{{ product.images.size }}</span>{%- endif -%}
          <a href="#vibe-recs" class="fgsimilar">{% render 'vibe-icon', name:'search', size:14 %} Similar</a>
          <div class="fgmain__track" data-fgtrack>
            {%- if product.images.size > 0 -%}
              {%- for image in product.images -%}
                <div class="fgslide"><img src="{{ image | image_url: width: 900 }}" width="{{ image.width }}" height="{{ image.height }}" alt="{{ product.title | escape }}" {% unless forloop.first %}loading="lazy"{% endunless %}></div>
              {%- endfor -%}
            {%- else -%}
              <div class="fgslide"><span class="fph"><span class="fph__mesh tint-violet"></span></span></div>
            {%- endif -%}
          </div>
          {%- if product.images.size > 1 -%}<div class="fgmain__dots" data-fgdots>{%- for image in product.images -%}<i{% if forloop.first %} class="on"{% endif %}></i>{%- endfor -%}</div>{%- endif -%}
          {%- if product.compare_at_price > product.price -%}
            <div class="fgmain__badges"><span class="fbadge sale">{% render 'vibe-icon', name:'bolt', size:12 %} -{{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}%</span></div>
          {%- endif -%}
          <div class="fgmain__chips">
            {%- if product.available -%}<span class="fgmain__chip">{% render 'vibe-icon', name:'check', size:12, stroke:3, style:'color:var(--neon-cyan)' %}In stock</span>{%- endif -%}
            {%- if product.type != blank -%}<span class="fgmain__chip">{{ product.type }}</span>{%- endif -%}
            <span class="fgmain__chip">{% render 'vibe-icon', name:'shield', size:12, style:'color:var(--neon-blue)' %}Buyer protection</span>
          </div>
        </div>
      </div>

      <!-- info -->
      <div>
        <div class="fpdp-head">
          <span class="fpdp-brand">{{ product.vendor | default: 'Wanelo' }}</span>
          <span class="fbadge orig">{% render 'vibe-icon', name:'check', size:12, stroke:3 %} Original</span>
        </div>
        <h1>{{ product.title }}</h1>

        <form method="post" action="{{ routes.cart_add_url }}" id="vibe-pform" accept-charset="UTF-8" enctype="multipart/form-data">
          <input type="hidden" name="form_type" value="product"><input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="id" value="{{ cv.id }}" data-variant-id>

          {%- unless product.has_only_default_variant -%}
            {%- assign vlimit = 5 -%}
            {%- assign vimg_count = 0 -%}
            {%- for v in product.variants -%}{%- if v.image -%}{%- assign vimg_count = vimg_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
            {%- if vimg_count > 0 -%}
            <div class="fvpick" data-vpick>
              <div class="fvpick__lbl">{{ product.options.first }}: <b data-vlabel>{{ cv.title }}</b></div>
              <div class="fvpick__row">
                {%- for v in product.variants -%}{%- if forloop.index <= vlimit -%}{%- assign vimg = v.image | default: product.featured_image -%}
                <button type="button" class="fvthumb{% if v.id == cv.id %} on{% endif %}" data-vid="{{ v.id }}" data-vtitle="{{ v.title | escape }}" data-vprice="{{ v.price }}" data-vcompare="{{ v.compare_at_price | default: 0 }}"{% if v.image %} data-vimg="{{ v.image | image_url: width: 300 }}"{% endif %} aria-label="{{ v.title | escape }}">{%- if vimg -%}<img src="{{ vimg | image_url: width: 140 }}" alt="" width="60" height="60" loading="lazy">{%- else -%}<span class="fvthumb__ph"></span>{%- endif -%}</button>{%- endif -%}{%- endfor -%}
                {%- if product.variants.size > vlimit -%}<button type="button" class="fvthumb fvthumb--more" data-vall aria-label="All variants"><b>+{{ product.variants.size | minus: vlimit }}</b><span>All {{ product.variants.size }}</span></button>{%- endif -%}
              </div>
            </div>
            {%- else -%}
            <div class="fvpick fvpick--pills" data-vpick>
              <div class="fvpick__lbl">{{ product.options.first }}: <b data-vlabel>{{ cv.title }}</b></div>
              <div class="fvpills">
                {%- for v in product.variants -%}
                <button type="button" class="fvpill{% if v.id == cv.id %} on{% endif %}" data-vid="{{ v.id }}" data-vtitle="{{ v.title | escape }}" data-vprice="{{ v.price }}" data-vcompare="{{ v.compare_at_price | default: 0 }}">{{ v.title }}</button>{%- endfor -%}
              </div>
            </div>
            {%- endif -%}
          {%- endunless -%}

          {%- comment -%} WB-style rating / reviews / questions strip {%- endcomment -%}
          {%- assign rvv = product.metafields.custom.reviews.value -%}
          {%- assign fqv = product.metafields.custom.faq.value -%}
          {%- if rvv.items.size > 0 or fqv.items.size > 0 -%}
            {%- assign rtotal = 0 -%}{%- for it in rvv.items -%}{%- assign ssz = it.stars | remove: '☆' | remove: '✩' | size -%}{%- assign rtotal = rtotal | plus: ssz -%}{%- endfor -%}
            <div class="fsocial">
              {%- if rvv.items.size > 0 -%}{%- assign ravg = rtotal | times: 1.0 | divided_by: rvv.items.size | round: 1 -%}<a href="#vibe-reviews" class="fsocial__rate"><span class="fsocial__big">{{ ravg }}</span><span class="fsocial__stars">{% for i in (1..5) %}{% render 'vibe-icon', name:'star', size:13, fill:'#ffb020', stroke:0, style:'color:#ffb020' %}{% endfor %}</span><span class="fsocial__cnt">{{ rvv.items.size }} reviews</span></a>{%- endif -%}
              {%- if fqv.items.size > 0 -%}<a href="#vibe-faq" class="fsocial__q">{% render 'vibe-icon', name:'check', size:14, stroke:2.6 %}<b>{{ fqv.items.size }}</b><span>questions</span></a>{%- endif -%}
            </div>
          {%- endif -%}

          {%- comment -%} key specs preview from metafield {%- endcomment -%}
          {%- assign specs = product.metafields.custom.specs.value -%}
          {%- if specs.items -%}
            <div class="fkspec">
              {%- for it in specs.items limit: 8 -%}
                <div class="fkspec__row"><div class="k"><span>{{ it.k | default: it.label | default: it[0] }}</span></div><div class="v">{{ it.v | default: it.value | default: it[1] }}</div></div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </form>
      </div>

      <!-- buybox -->
      <div class="fbuybox glass">
        <div class="fbb-price">
          <span class="fbb-now neon-text" data-price>{{ cv.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}<span class="fbb-old" data-cprice>{{ product.compare_at_price | money }}</span>{%- endif -%}
        </div>
        {%- if product.compare_at_price > product.price -%}<span class="fbb-save">{% render 'vibe-icon', name:'bolt', size:13 %} Save {{ product.compare_at_price | minus: product.price | money }}</span>{%- endif -%}
        <div class="fbb-pay">or <b>{{ cv.price | divided_by: 4 | money }} × 4</b> with Wanelo Pay · 0%</div>
        <div class="fbb-actions">
          <div class="fqty">
            <button type="button" data-qty="-1">{% render 'vibe-icon', name:'minus', size:18, stroke:2.4 %}</button>
            <span data-qty-val>1</span>
            <button type="button" data-qty="1">{% render 'vibe-icon', name:'plus', size:18, stroke:2.4 %}</button>
          </div>
          <button type="button" class="fbtn fbtn-primary" style="flex:1;height:50px" data-pdp-add {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</button>
        </div>
        <a href="{{ routes.cart_url }}" class="fbtn fbtn-glass fbb-buynow" style="width:100%;height:50px">View cart</a>
        <div class="fbb-deliv">
          <div class="fbb-deliv__row">{% render 'vibe-icon', name:'truck', size:20 %}<div><b>Fast delivery</b><div class="muted">tracked, worldwide</div></div></div>
          <div class="fbb-deliv__row">{% render 'vibe-icon', name:'shield', size:20 %}<div><b>Buyer protection</b><div class="muted">every order insured end-to-end</div></div></div>
        </div>
        <div class="fbb-store"><span class="logo">W</span><div><b>Sold &amp; shipped by {{ shop.name }}</b><div style="color:var(--txt-2)">Official store</div></div></div>
      </div>
    </div>

    {%- comment -%} ===== designer metafield sections (custom.*) — ALL types via generic Vibe renderer ===== {%- endcomment -%}
    {%- assign mf = product.metafields.custom -%}
    {%- assign mf_order = 'hero,features,reviews,how_to,stats,compare,ingredients,nutrition_facts,timeline,progress_milestones,use_scenarios,whats_included,story,brand_story,clinical_evidence,research_refs,protocol,scent_profile,compatibility,size_guide,dimensions,assembly,room_placement,care,safety,mistake_warnings,target_profile,sustainability,trust,trust_strip,subscription_refill,gift_options,unboxing_journey,lifestyle_gallery,app_showcase' | split: ',' -%}
    {%- for key in mf_order -%}
      {%- assign mval = mf[key].value -%}
      {%- if mval != blank -%}{% render 'vibe-meta', key: key, val: mval %}{%- endif -%}
    {%- endfor -%}

    <!-- About: WB-style tabbed spec sheet (Specifications / Description) -->
    {%- if specs.items or product.description != blank -%}
    {%- assign sku = cv.sku | default: product.variants.first.sku -%}
    <section class="fpsec fabout" style="margin-top:52px" data-about>
      <h2>About this item</h2>
      <div class="fabout__tabs" role="tablist">
        {%- if specs.items -%}<button type="button" class="fabout__tab on" data-atab="specs">Specifications</button>{%- endif -%}
        {%- if product.description != blank -%}<button type="button" class="fabout__tab{% unless specs.items %} on{% endunless %}" data-atab="desc">Description</button>{%- endif -%}
      </div>

      {%- if specs.items -%}
      <div class="fabout__panel on glass" data-apanel="specs">
        {%- assign show_brand = false -%}{%- if product.vendor != blank and product.vendor != shop.name -%}{%- assign show_brand = true -%}{%- endif -%}{%- if show_brand or product.type != blank or sku != blank -%}
        <div class="fspecgrp">
          <div class="fspecgrp__h">Main information</div>
          {%- if product.vendor != blank and product.vendor != shop.name -%}<div class="fspecrow"><span class="k">Brand</span><span class="dots"></span><span class="v">{{ product.vendor }}</span></div>{%- endif -%}
          {%- if product.type != blank -%}<div class="fspecrow"><span class="k">Category</span><span class="dots"></span><span class="v">{{ product.type }}</span></div>{%- endif -%}
          {%- if sku != blank -%}<div class="fspecrow"><span class="k">SKU</span><span class="dots"></span><span class="v">{{ sku }}</span></div>{%- endif -%}
        </div>
        {%- endif -%}
        <div class="fspecgrp">
          <div class="fspecgrp__h">Details</div>
          {%- for it in specs.items -%}<div class="fspecrow"><span class="k">{{ it.k | default: it.label | default: it[0] }}</span><span class="dots"></span><span class="v">{{ it.v | default: it.value | default: it[1] }}</span></div>{%- endfor -%}
        </div>
        <div class="fabout__verified">{% render 'vibe-icon', name:'shield', size:16 %} Documents verified</div>
      </div>
      {%- endif -%}

      {%- if product.description != blank -%}
      <div class="fabout__panel{% unless specs.items %} on{% endunless %} glass" data-apanel="desc">
        <div class="rte" style="padding:2px">{{ product.description }}</div>
      </div>
      {%- endif -%}
    </section>
    {%- endif -%}

    {%- assign mf_end = 'faq,cta,interlinks' | split: ',' -%}
    {%- for key in mf_end -%}{%- assign mval = mf[key].value -%}{%- if mval != blank -%}{% render 'vibe-meta', key: key, val: mval %}{%- endif -%}{%- endfor -%}

    <!-- recommendations -->
    {%- assign recsrc = product.collections.first -%}
    {%- if recsrc and recsrc.products.size > 1 -%}
    <section class="fpsec" id="vibe-recs">
      <h2>You might also like</h2>
      <div class="fgrid" style="--fc:6" data-recs-grid data-recs-src="{{ recsrc.url }}" data-recs-self="{{ product.handle }}">
        {%- assign shown = 0 -%}
        {%- for p in recsrc.products limit: 12 -%}
          {%- if p.id != product.id and shown < 6 -%}
            {%- assign shown = shown | plus: 1 -%}
            {% render 'vibe-card', product: p, tint: 'tint-cyan' %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
    {%- endif -%}
  </div>
  {%- unless product.has_only_default_variant -%}{%- if vimg_count > 0 and product.variants.size > vlimit -%}
  <div class="fvmodal" data-vmodal>
    <div class="fvmodal__bg" data-vclose></div>
    <div class="fvmodal__sheet">
      <div class="fvmodal__head"><b>{{ product.options.first }} · {{ product.variants.size }}</b><button type="button" class="fvmodal__x" data-vclose aria-label="Close">✕</button></div>
      <div class="fvmodal__grid">
        {%- for v in product.variants -%}{%- assign vimg = v.image | default: product.featured_image -%}
        <button type="button" class="fvcard{% if v.id == cv.id %} on{% endif %}" data-vid="{{ v.id }}" data-vtitle="{{ v.title | escape }}" data-vprice="{{ v.price }}" data-vcompare="{{ v.compare_at_price | default: 0 }}"{% if v.image %} data-vimg="{{ v.image | image_url: width: 300 }}"{% endif %}>{%- if vimg -%}<img src="{{ vimg | image_url: width: 200 }}" alt="" width="92" height="92" loading="lazy">{%- else -%}<span class="fvthumb__ph"></span>{%- endif -%}<span class="fvcard__t">{{ v.title }}</span><span class="fvcard__p">{{ v.price | money }}</span></button>{%- endfor -%}
      </div>
    </div>
  </div>
  {%- endif -%}{%- endunless -%}
  <script>
  (function(){
    var sec=document.getElementById('vibe-recs'); if(!sec) return;
    var grid=sec.querySelector('[data-recs-grid]'); if(!grid) return;
    var src=grid.getAttribute('data-recs-src'), selfH=grid.getAttribute('data-recs-self');
    var sources=[src,'/collections/all'].filter(Boolean), si=0, page=null, busy=false, done=false;
    function handleOf(card){ var a=card.querySelector('a[href*="/products/"]'); if(!a) return null; var m=a.getAttribute('href').match(/\/products\/([^\/?#]+)/); return m?m[1]:null; }
    var seen={}; [].forEach.call(grid.querySelectorAll('.fpcard'),function(c){ var h=handleOf(c); if(h) seen[h]=1; }); if(selfH) seen[selfH]=1;
    function reinit(){ try{ document.dispatchEvent(new CustomEvent('shopify:section:load')); }catch(e){} }
    function fetchCards(url){ return fetch(url,{credentials:'same-origin'}).then(function(r){return r.ok?r.text():'';}).then(function(html){ if(!html) return {cards:[],next:null}; var d=new DOMParser().parseFromString(html,'text/html'); var g=d.querySelector('.fcat .fgrid'); var nm=d.querySelector('.fmore a'); return {cards:g?[].slice.call(g.querySelectorAll('.fpcard')):[], next:nm?nm.getAttribute('href'):null}; }).catch(function(){return {cards:[],next:null};}); }
    function load(){
      if(busy||done) return; busy=true;
      if(si>=sources.length){ done=true; busy=false; return; }
      fetchCards(page||sources[si]).then(function(res){
        var frag=document.createDocumentFragment(),n=0;
        res.cards.forEach(function(c){ var h=handleOf(c); if(!h||seen[h]) return; seen[h]=1; frag.appendChild(c); n++; });
        if(n){ grid.appendChild(frag); reinit(); }
        if(res.next){ page=res.next; } else { page=null; si++; }
        busy=false;
        if(near()) load();
      });
    }
    function near(){ var r=sec.getBoundingClientRect(); return r.bottom < (window.innerHeight + 900); }
    var tick=false;
    window.addEventListener('scroll', function(){ if(tick)return; tick=true; requestAnimationFrame(function(){ tick=false; if(near()) load(); }); }, {passive:true});
    window.addEventListener('resize', function(){ if(near()) load(); }, {passive:true});
  })();
  </script>
  {% render 'vibe-footer' %}
</div>

<script>
(function(){
  var VARIANTS = {{ product.variants | json }};
  var form = document.getElementById('vibe-pform'); if(!form) return;
  var idInput = form.querySelector('[data-variant-id]');
  var priceEl = document.querySelector('[data-price]'), cpriceEl=document.querySelector('[data-cprice]');
  var track = document.querySelector('[data-fgtrack]');
  var fgdots = document.querySelectorAll('[data-fgdots] i');
  var fgthumbs = document.querySelectorAll('[data-fgthumb]');
  var fgcount=document.querySelector('[data-fgcount]');
  function fgActive(){ if(!track||!track.clientWidth) return; var i=Math.round(track.scrollLeft/track.clientWidth); fgdots.forEach(function(d,k){ d.classList.toggle('on',k===i); }); fgthumbs.forEach(function(t,k){ t.classList.toggle('on',k===i); }); if(fgcount) fgcount.textContent=i+1; }
  if(track){ track.addEventListener('scroll', function(){ requestAnimationFrame(fgActive); }, {passive:true}); }
  fgthumbs.forEach(function(t){ t.addEventListener('click', function(){ if(track) track.scrollTo({left:(+t.getAttribute('data-fgthumb'))*track.clientWidth, behavior:'smooth'}); }); });
  var fgback=document.querySelector('[data-fgback]'); if(fgback) fgback.addEventListener('click', function(){ if(history.length>1){ history.back(); } else { location.href={{ product.collections.first.url | default: routes.collections_url | json }}; } });
  var fgshare=document.querySelector('[data-fgshare]'); if(fgshare) fgshare.addEventListener('click', function(){ if(navigator.share){ navigator.share({title:document.title, url:location.href}).catch(function(){}); } else if(navigator.clipboard){ navigator.clipboard.writeText(location.href); fgshare.classList.add('on'); setTimeout(function(){fgshare.classList.remove('on');},1200); } });
  function money(c){ try{ return (c/100).toLocaleString(undefined,{style:'currency',currency:'{{ cart.currency.iso_code | default: shop.currency }}'}); }catch(e){ return (c/100).toFixed(2); } }
  var vlabel=document.querySelector('[data-vlabel]');
  var vmodal=document.querySelector('[data-vmodal]');
  function closeVModal(){ if(vmodal){ vmodal.classList.remove('open'); document.body.style.overflow=''; } }
  function selectVariant(btn){
    var id=btn.getAttribute('data-vid'); if(idInput) idInput.value=id;
    document.querySelectorAll('.fvthumb.on,.fvcard.on,.fvpill.on').forEach(function(x){ x.classList.remove('on'); });
    document.querySelectorAll('[data-vid="'+id+'"]').forEach(function(x){ x.classList.add('on'); });
    if(vlabel) vlabel.textContent=btn.getAttribute('data-vtitle');
    var p=parseInt(btn.getAttribute('data-vprice'),10); if(priceEl && !isNaN(p)) priceEl.textContent=money(p);
    var cp=parseInt(btn.getAttribute('data-vcompare'),10)||0; if(cpriceEl) cpriceEl.style.display=(cp>p)?'':'none';
    var vimg=btn.getAttribute('data-vimg');
    if(vimg && track){ function st(u){ u=(u||'').split('?')[0]; u=u.substring(u.lastIndexOf('/')+1); return u.replace(/_\d+x\d*(\.\w+)?$/,'').replace(/\.\w+$/,''); } var vstem=st(vimg); var slides=[].slice.call(track.querySelectorAll('.fgslide')); for(var i=0;i<slides.length;i++){ var im=slides[i].querySelector('img'); if(im && st(im.getAttribute('src'))===vstem){ track.scrollLeft=i*track.clientWidth; break; } } }
  }
  document.querySelectorAll('[data-vid]').forEach(function(b){ b.addEventListener('click', function(){ selectVariant(b); if(b.closest('[data-vmodal]')) closeVModal(); }); });
  document.querySelectorAll('[data-vall]').forEach(function(b){ b.addEventListener('click', function(){ if(vmodal){ vmodal.classList.add('open'); document.body.style.overflow='hidden'; } }); });
  document.querySelectorAll('[data-vclose]').forEach(function(c){ c.addEventListener('click', closeVModal); });
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') closeVModal(); });
  // About tabs (Specifications / Description)
  document.querySelectorAll('[data-about]').forEach(function(ab){
    var tabs=ab.querySelectorAll('[data-atab]'), panels=ab.querySelectorAll('[data-apanel]');
    tabs.forEach(function(t){ t.addEventListener('click', function(){
      tabs.forEach(function(x){ x.classList.remove('on'); }); t.classList.add('on');
      var key=t.getAttribute('data-atab');
      panels.forEach(function(p){ p.classList.toggle('on', p.getAttribute('data-apanel')===key); });
    }); });
  });
  // qty
  var q=1, qv=document.querySelector('[data-qty-val]');
  document.querySelectorAll('[data-qty]').forEach(function(b){ b.addEventListener('click',function(){ q=Math.max(1,q+(+b.getAttribute('data-qty'))); if(qv) qv.textContent=q; }); });
  // add to cart
  var addBtn=document.querySelector('[data-pdp-add]');
  if(addBtn) addBtn.addEventListener('click',function(){
    var old=addBtn.innerHTML; addBtn.textContent='✓ In cart';
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:[{id:+idInput.value,quantity:q}]})})
      .then(function(r){return r.json()}).then(function(){ var c=document.querySelector('.fhdr .ficon .cnt'); if(c){c.textContent=(parseInt(c.textContent||'0')+q);} setTimeout(function(){addBtn.innerHTML=old;},1600); })
      .catch(function(){ addBtn.innerHTML=old; });
  });
})();

  // metafield/section reveal-on-scroll (IntersectionObserver — fires as each section actually enters the viewport)
  (function(){
    var root = document.querySelector('.vibe-home'); if(!root) return;
    var secs = [].slice.call(document.querySelectorAll('.fpsec'));
    if(!secs.length) return;
    if(!('IntersectionObserver' in window)){ secs.forEach(function(s){ s.classList.add('in'); }); return; }
    root.classList.add('vibe-reveal');
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { root: null, rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
    secs.forEach(function(s){ io.observe(s); });
    setTimeout(function(){ secs.forEach(function(s){ s.classList.add('in'); }); try{io.disconnect();}catch(e){} }, 8000);
  })();
</script>

